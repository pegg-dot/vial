# Environment variables.
#
# ⚠️ The names here were stale for weeks: they used the pre-rename VIAL_* prefix while the code reads
# VIALGRADE_*. Anyone following this file set variables nothing looked at, and the code then fell
# back to insecure defaults in silence — an empty privacy salt makes visitor hashes reversible, and
# a missing NEXT_PUBLIC_SITE_URL puts a placeholder domain in every canonical tag and share card.
# If you add a variable to the code, add it here in the same commit.

# Public origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Managed PostgreSQL is required in deployed production environments.
# Leave blank only for local development, tests, and build-time rendering.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_SSL=false

# Optional embedded PGlite development controls.
VIALGRADE_PGLITE_MEMORY=false
VIALGRADE_PGLITE_PATH=.data/pglite
# Test-only localhost production audits. Never enable publicly.
VIALGRADE_ALLOW_EMBEDDED_DB_FOR_TESTS=false

# Required in production. Use independent random values of at least 32 chars.
VIALGRADE_SESSION_SECRET=
VIALGRADE_PRIVACY_HASH_SECRET=

# Fixture/demo account switches. Keep false in deployed production.
VIALGRADE_SEED_FIXTURES=false
VIALGRADE_SEED_DEMO_ACCOUNTS=false

# Bearer token used by the controlled refresh cron route.
CRON_SECRET=

# Build/release identity
VIALGRADE_BUILD_SHA=development
VIALGRADE_RELEASE=6.0.0

# Optional scoped token for the local VIAL Seller MCP stdio server.
# Create it in /seller/developer. Never commit a real token.
VIALGRADE_MCP_SELLER_TOKEN=

# Optional scoped token for the local VIAL Laboratory MCP stdio server.
# Create it in /lab/developer. Never commit a real token.
VIALGRADE_MCP_LAB_TOKEN=

# VIAL 5 commerce provider boundary. Keep sandbox/mock unless underwriting,
# legal review, seller contracts, and SKU decisions are complete.
VIALGRADE_COMMERCE_MODE=sandbox
VIALGRADE_PAYMENT_PROVIDER=mock
VIALGRADE_COMMERCE_POLICY_VERSION=commerce-v5.0
VIALGRADE_PLATFORM_COUNTRY=US
VIALGRADE_PLATFORM_CURRENCY=USD

# Stripe test-mode adapter. Never commit real keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Live activation is deliberately double-gated and should remain false.
VIALGRADE_LIVE_COMMERCE_ENABLED=false
VIALGRADE_LIVE_COMMERCE_ACK=

ANTHROPIC_API_KEY=
VIALGRADE_EXTRACTOR=deterministic
VIALGRADE_EXTRACTOR_MAX_TOKENS=4000
VIALGRADE_EXTRACTOR_DAILY_BUDGET_CENTS=200

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@vialgrade.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Added: present in code but missing from this file, which is how they got misconfigured ---

# Turns on live fetching of third-party storefronts. Collection is intentional, never a default.
VIALGRADE_LIVE_INGEST_APPROVED=

# Optional. A Discord or Slack webhook URL. When set, real failures also post a short message so an
# outage reaches a phone instead of only a log. See docs/MONITORING.md.
VIALGRADE_ALERT_WEBHOOK=

# The admin password, hashed on boot. Never commit a real value.
VIALGRADE_ADMIN_PASSWORD=
